{
  "name": "@pulso/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:seed-curated-venues": "tsx src/seed-curated-venues.ts",
    "db:categorize-known-venues": "tsx src/categorize-known-venues.ts",
    "db:ingest": "tsx src/ingest.ts",
    "db:cleanup-vdm-duplicates": "tsx src/cleanup-vdm-duplicates.ts",
    "db:merge-duplicate-venues": "tsx src/merge-duplicate-venues.ts",
    "db:rename-known-venues": "tsx src/rename-known-venues.ts",
    "db:merge-venues-by-name": "tsx src/merge-venues-by-name.ts",
    "instagram:scout": "tsx src/instagram-scout-pilot.ts",
    "instagram:scout:apply-decisions": "tsx src/instagram-scout-apply-decisions.ts",
    "instagram:scout:crosscheck": "tsx src/instagram-scout-crosscheck.ts",
    "instagram:scout:link-venues": "tsx src/instagram-scout-link-venues.ts",
    "instagram:scout:import-verified-pilot": "tsx src/instagram-scout-import-verified-pilot.ts",
    "instagram:scout:review": "tsx src/instagram-scout-review-ui.ts",
    "instagram:scout:visual": "tsx src/instagram-scout-pilot.ts --visual",
    "instagram:scout:pipeline": "tsx src/instagram-scout-pilot.ts --visual && tsx src/instagram-scout-crosscheck.ts && tsx src/instagram-scout-review-ui.ts",
    "instagram:stories": "tsx src/instagram-stories-pilot.ts",
    "instagram:stories:review": "tsx src/instagram-stories-review-ui.ts",
    "instagram:stories:pipeline": "tsx src/instagram-stories-pilot.ts && tsx src/instagram-stories-review-ui.ts",
    "instagram:unified": "tsx src/instagram-unified-pilot.ts",
    "instagram:unified:review": "tsx src/instagram-unified-review-ui.ts",
    "instagram:unified:pipeline": "tsx src/instagram-unified-pilot.ts && tsx src/instagram-unified-review-ui.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pulso/contracts": "workspace:*",
    "@pulso/domain": "workspace:*",
    "@pulso/ingestion": "workspace:*",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
