  "dependencies": {
    "@pulso/contracts": "workspace:*",
    "@pulso/domain": "workspace:*",
    "@pulso/ingestion": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
