{
  "name": "@pulso/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file=../../.env node_modules/tsx/dist/cli.mjs watch src/server.ts",
