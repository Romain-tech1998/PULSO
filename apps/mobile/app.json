{
  "expo": {
    "name": "Pulso",
    "slug": "pulso",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "@maplibre/maplibre-react-native",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["fr", "en"],
            "android": ["fr", "en"]
          }
        }
      ]
    ],
    "android": {
      "package": "com.pulso.mobile"
    }
  }
}