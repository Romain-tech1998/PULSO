{
  "expo": {
    "name": "Pulso",
    "slug": "pulso",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/brand/pulso-app-icon-dark.png",
    "backgroundColor": "#0c0a12",
    "splash": {
      "image": "./assets/brand/pulso-splash-mark.png",
      "backgroundColor": "#0c0a12",
      "resizeMode": "contain"
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["fr", "en"],
            "android": ["fr", "en"]
          }
        }
      ]
    ],
    "android": {
      "package": "com.pulso.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/pulso-adaptive-foreground.png",
        "backgroundColor": "#0c0a12"
      }
    }
  }
}
