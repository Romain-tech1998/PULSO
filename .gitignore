# Dependencies
node_modules/
.pnpm-store/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage
test-results/
playwright-report/

# Next.js
/.next/
**/.next/
/out/
/.expo/
**/.expo/
**/.expo-home/

# Expo generated native projects (continuous native generation)
/apps/mobile/android/
/apps/mobile/ios/

# Production
/build
**/dist/

# Miscellaneous
.DS_Store
*.pem

# Ingestion pilot output (local review artifacts, not source)
/packages/database/ingestion-output/

# Uploaded event photos (local disk storage, Phase 4.8 follow-up) - user
# content, not source; see DEC-0012 v1.2.
/apps/api/uploads/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# Chromium writes this one from the Electron shell the map runs in - GPU
# driver chatter, regenerated on every run, never worth reading twice.
debug.log

# Environment files
.env*
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Local OCR models (tesseract), downloaded not authored - 37 MB
*.traineddata

# Local scratch/output from ingestion pilots and agent runs
/output/
/tmp/
/packages/ingestion/scratch/

# Claude Code, per-machine only. settings.local.json holds a permission
# allow-list carrying absolute paths from one developer's home directory,
# and worktrees/ is scratch state the tool manages itself. The shared half
# of this directory - launch.json, which is how the API and web dev servers
# are started - is tracked.
/.claude/settings.local.json
/.claude/worktrees/

# Knowledge-graph output from the graphify skill - generated from the
# repository itself, so it is regenerated rather than reviewed, and its
# ~35 cache files otherwise sit in every git status and format check.
/graphify-out/
