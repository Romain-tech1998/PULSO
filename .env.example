# Safe local-development defaults only. Copy to .env and keep that file untracked.
#
# ---------------------------------------------------------------------------
# DEPLOYMENT
# ---------------------------------------------------------------------------
# Set PULSO_ENV=production when serving a real domain. The API then REFUSES
# TO START unless the variables below are set correctly, instead of silently
# falling back to localhost (see apps/api/src/config.ts). Leave it unset
# locally.
#PULSO_ENV=production
#
# Public https:// origin of the API itself. Required in production: it is the
# Google OAuth redirect base and the prefix of every uploaded photo URL, and
# it cannot be derived from what the process binds to. Must also be declared
# as an authorized redirect URI in the Google Cloud console, as
# {API_PUBLIC_URL}/auth/google/callback.
#API_PUBLIC_URL=https://api.your-domain.com
#
# Persistent volume for uploaded photos. Required in production: on an
# ephemeral filesystem every event cover and forum photo is lost on the next
# deploy.
#EVENT_PHOTOS_UPLOAD_DIR=/data/uploads
#
# Read at BUILD time by Next, not at runtime - it must be present when the
# web app is built or the front end will call localhost in production.
#NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com
#
# Used for canonical/OpenGraph URLs (metadataBase).
#NEXT_PUBLIC_BASE_URL=https://your-domain.com
#
# Closed beta ships noindex. Set to true only at public launch.
#NEXT_PUBLIC_ALLOW_INDEXING=true
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://pulso:pulso@localhost:5432/pulso
API_HOST=127.0.0.1
API_PORT=3001
# Must match API_HOST exactly (127.0.0.1), not "localhost" - browsers treat
# the two as different hosts with separate cookie jars, which breaks the
# Google OAuth state-cookie check below even though both resolve identically.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional user accounts (DEC-0007/MVP-0001: account stays optional).
# Absent means the account layer is simply unavailable - every other route
# is unaffected. Create an OAuth 2.0 client at
# https://console.cloud.google.com/apis/credentials with authorized
# redirect URI {API_HOST}:{API_PORT}/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Intelligent search (packages/search/src/ai.ts). Key from
# https://openrouter.ai/keys. Absent means /search silently falls back to the
# deterministic engine - every query still works, it just interprets less.
# Billed per call and called on every intelligent search, so treat it as a
# cost line, not a free capability.
OPENROUTER_API_KEY=

# Image moderation (DEC-0021, apps/api/src/image-moderation-openai.ts). Key
# from https://platform.openai.com/api-keys - a different account and a
# different key from OPENROUTER_API_KEY above, because OpenRouter does not
# proxy the /moderations endpoint this uses.
#
# Absent does NOT mean "no screening". It means every uploaded image is held
# for review instead of being published, which is the deliberate fail-closed
# default: an unconfigured or unreachable provider must never become
# permission to publish. Leaving this empty therefore fills the
# administration queue rather than disabling the feature.
#
# Server-side only. It is read in apps/api and never reaches the browser.
OPENAI_API_KEY=

# Provisional public development basemap; no key or production commitment.
# The web dark style (apps/web/public/map-styles/pulso-dark.json) is a
# recolored copy of OpenFreeMap Liberty; regenerate it with
# `pnpm --filter @pulso/web run build:dark-style`.
NEXT_PUBLIC_MAP_STYLE_URL=./map-styles/pulso-dark.json
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Ingestion connectors (packages/ingestion) — see DATA-0003 for setup details.
# Free key from https://developer.ticketmaster.com
TICKETMASTER_API_KEY=
# Requires a Meta app + your own linked Instagram Business/Creator account.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Optional comma-separated DATA-0002 source ids. When omitted, the supervised
# pilot uses: new-city-gas, mtelus, club-soda, newspeak, evenko.
INSTAGRAM_SCOUT_PILOT_SOURCE_IDS=

# Parse.bot RA (Resident Advisor) scraper - https://parse.bot, requires an
# account and the scraper configured under SCRAPER_ID in
# packages/ingestion/src/sources/parse-bot-ra.ts.
PARSE_BOT_API_KEY=
# Apify (console.apify.com, Settings > Integrations) - runs the "Eventbrite
# Scraper — Event & Organizer Data" actor (Eventbrite's own public search API
# was retired in 2020, see DATA-0003). Billed per result (~$0.02/event on the
# free tier); only run on a slow cadence (weekly), never on every ingest -
# see `pnpm --filter @pulso/database db:ingest -- --eventbrite`.
APIFY_API_TOKEN=

# DEC-0022 §3 — signs the payload inside every ticket QR. Required in
# production; a development default is used when unset. Rotating it
# invalidates every outstanding QR, which is the emergency lever, not an
# everyday operation. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TICKET_SIGNING_SECRET=

# DEC-0022 §8, narrowed by v1.2 and DEC-0026 §3 — Stripe. Test keys need
# nothing else. A key containing "_live_" is refused unless all three of
# PULSO_ENV=production, a non-zero PULSO_APPLICATION_FEE_BPS and
# STRIPE_LIVE_AUTHORIZED below are set together, so a live key on a
# workstation still stops the process.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# DEC-0026 §3 — set to exactly "DEC-0026" to authorize live mode, and only
# once the four conditions in that document's table each carry a date: the
# accountant's review, the lawyer's review, a decided commission rate, and the
# deployment. It names the decision so that whoever sets it has read what it
# says. Leave empty everywhere else, including on your own machine.
STRIPE_LIVE_AUTHORIZED=

# DEC-0022 §1 — Pulso's commission, in basis points, ADDED ON TOP of the price
# the organizer sets. 1000 = 10%: a 10.00 $ ticket is shown to the buyer at
# 11.00 $, the organizer receives 10.00 $ less Stripe's own processing fee,
# and Pulso receives 1.00 $. Zero (the default) adds nothing and shows
# nothing. §8 makes a decided rate a prerequisite for live mode, and DEC-0026
# §3 decides it: 1000. Production sets that; this file stays at zero so a
# local test-mode charge carries no commission nobody meant to charge.
PULSO_APPLICATION_FEE_BPS=0
# How long an open checkout holds its seats before they go back on sale.
PULSO_CHECKOUT_HOLD_MINUTES=20

# DEC-0022 §4 — Google Wallet. All four are required together: a
# half-configured issuer renders an "Add to Wallet" button that produces a
# broken pass, which the decision calls worse than no button. Absent (the
# default) means no wallet export and no button anywhere; the in-app QR is
# the ticket either way.
# From the Google Pay & Wallet console, plus a service-account key.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# PEM with literal \n escapes, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE..."
GOOGLE_WALLET_PRIVATE_KEY=
GOOGLE_WALLET_CLASS_ID=

# Apple Wallet is deliberately not implemented: a .pkpass needs a detached
# PKCS#7 signature made with an Apple-issued Pass Type ID certificate
# (Apple Developer Program, 99 USD/yr). See DEC-0022 §4.
